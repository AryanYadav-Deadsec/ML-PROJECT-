"""
baseline_model.py

Trains the interpretable baseline model from PRD section 5, requirement 4:
a classical ML classifier (Logistic Regression / Random Forest) over the
handcrafted features from feature_extraction.py, with SHAP explanations
(requirement 9) attached.

Usage:
    python baseline_model.py                       # one combined model, all 4 languages
    python baseline_model.py --per-language         # one model per language
    python baseline_model.py --language python      # just Python
    python baseline_model.py --skip-shap             # skip SHAP if it's not installed

Reads:  data/splits/{train,val,test}.jsonl  (from dataset_builder.py)
Writes: models/baseline_<scope>.joblib
        models/baseline_<scope>_shap_summary.png   (if SHAP available)
"""

import argparse
import json
import logging
from pathlib import Path

import joblib
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, f1_score
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

import config
import feature_extraction

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
log = logging.getLogger("baseline_model")

MODELS_DIR = config.ROOT_DIR / "models"
MODELS_DIR.mkdir(exist_ok=True)

LABEL_MAP = {"human_written": 0, "ai_generated": 1}


def load_split(name):
    path = config.SPLITS_DIR / f"{name}.jsonl"
    if not path.exists():
        raise FileNotFoundError(f"{path} not found -- run dataset_builder.py first.")
    with open(path, encoding="utf-8") as f:
        return [json.loads(line) for line in f if line.strip()]


def check_problem_id_leakage(train, test):
    """AI-generated samples carry a problem_id (which seed prompt they came
    from). If the same problem_id shows up in both train and test, the
    model can partly learn 'this looks like problem p007' rather than
    genuine AI-vs-human style -- inflating test accuracy in a way that
    won't hold up on truly unseen code. This only warns; it doesn't
    re-split for you, since dataset_builder.py's split doesn't group by
    problem_id yet."""
    train_pids = {r["problem_id"] for r in train if r.get("problem_id")}
    test_pids = {r["problem_id"] for r in test if r.get("problem_id")}
    overlap = train_pids & test_pids
    if overlap:
        log.warning(
            "TRAIN/TEST LEAKAGE RISK: %d problem_id(s) appear in both train and "
            "test (%s%s). Test F1 may be optimistic -- treat it as an upper "
            "bound, not a generalization estimate, until dataset_builder.py's "
            "split is made problem_id-aware.",
            len(overlap), ", ".join(sorted(overlap)[:5]), ", ..." if len(overlap) > 5 else "",
        )
    else:
        log.info("No problem_id overlap between train and test AI samples. Good.")


def build_feature_matrix(records, language_filter=None, feature_cols=None):
    rows, labels, kept = [], [], []
    for r in records:
        if language_filter and r["language"] != language_filter:
            continue
        path = Path(r["local_path"])
        if not path.exists():
            log.warning("Missing file, skipping: %s", path)
            continue
        code = path.read_text(encoding="utf-8", errors="replace")
        feats = feature_extraction.extract_features(code, r["language"])
        rows.append(feats)
        labels.append(LABEL_MAP[r["label"]])
        kept.append(r)

    df = pd.DataFrame(rows)
    # Fixed column order/schema across train/val/test calls, so a model
    # trained on one DataFrame's columns lines up with another's.
    base_cols = feature_cols or feature_extraction.FEATURE_NAMES
    for col in base_cols:
        if col not in df.columns:
            df[col] = 0.0
    df = df[base_cols]

    if language_filter is None:
        # Combined multi-language model: one-hot language so the model can
        # learn language-specific baselines (e.g. JS's semicolon habits
        # differ from Python's) without four separate models.
        lang_dummies = pd.get_dummies(pd.Series([r["language"] for r in kept]), prefix="lang")
        for lang in config.LANGUAGES:
            col = f"lang_{lang}"
            if col not in lang_dummies.columns:
                lang_dummies[col] = 0
        df = pd.concat([df.reset_index(drop=True), lang_dummies.reset_index(drop=True)], axis=1)

    return df, np.array(labels), kept


def train_and_select(X_train, y_train, X_val, y_val):
    """Trains LogReg and Random Forest, picks whichever gets the better
    macro-F1 on val. class_weight='balanced' matters here -- the dataset
    is at real risk of human/AI imbalance (see PRD_v2 data-sourcing notes),
    and an unweighted model would just learn to guess the majority class."""
    candidates = {
        "logistic_regression": Pipeline([
            ("scaler", StandardScaler()),
            ("clf", LogisticRegression(max_iter=2000, class_weight="balanced", random_state=42)),
        ]),
        "random_forest": Pipeline([
            ("clf", RandomForestClassifier(
                n_estimators=300, class_weight="balanced", random_state=42, n_jobs=-1
            )),
        ]),
    }

    best_name, best_model, best_f1 = None, None, -1.0
    for name, pipe in candidates.items():
        pipe.fit(X_train, y_train)
        val_pred = pipe.predict(X_val)
        f1 = f1_score(y_val, val_pred, average="macro")
        log.info("[%s] val macro-F1 = %.4f", name, f1)
        log.info("\n%s", classification_report(y_val, val_pred, target_names=["human_written", "ai_generated"]))
        if f1 > best_f1:
            best_name, best_model, best_f1 = name, pipe, f1

    log.info("Selected model: %s (val macro-F1 = %.4f)", best_name, best_f1)
    return best_name, best_model


def run_shap(model_name, pipe, X_train, X_test, scope_label):
    try:
        import shap
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except ImportError:
        log.warning("shap/matplotlib not installed -- skipping explainability output. "
                    "Install with: pip install shap matplotlib")
        return

    clf = pipe.named_steps["clf"]
    background = X_train.sample(min(100, len(X_train)), random_state=42)
    sample = X_test.sample(min(200, len(X_test)), random_state=42)

    if model_name == "random_forest":
        explainer = shap.TreeExplainer(clf)
        shap_values = explainer.shap_values(sample)
        # shap_values for binary RF is a list [class0, class1]; use class 1 (ai_generated)
        values = shap_values[1] if isinstance(shap_values, list) else shap_values
    else:
        scaled = pipe.named_steps["scaler"].transform(sample)
        explainer = shap.LinearExplainer(clf, pipe.named_steps["scaler"].transform(background))
        values = explainer.shap_values(scaled)

    plt.figure()
    shap.summary_plot(values, sample, show=False, plot_type="bar")
    out_path = MODELS_DIR / f"baseline_{scope_label}_shap_summary.png"
    plt.tight_layout()
    plt.savefig(out_path, dpi=150)
    plt.close()
    log.info("Wrote SHAP summary plot: %s", out_path)


def run_scope(language, train, val, test, skip_shap):
    scope_label = language or "combined"
    log.info("=== Training baseline model: %s ===", scope_label)

    X_train, y_train, _ = build_feature_matrix(train, language_filter=language)
    feature_cols = list(X_train.columns)  # lock schema from train, reuse for val/test
    X_val, y_val, _ = build_feature_matrix(val, language_filter=language, feature_cols=feature_cols)
    X_test, y_test, test_kept = build_feature_matrix(test, language_filter=language, feature_cols=feature_cols)

    if len(X_train) == 0 or len(X_val) == 0:
        log.warning("Not enough data for scope '%s' -- skipping (train=%d, val=%d).",
                    scope_label, len(X_train), len(X_val))
        return

    model_name, pipe = train_and_select(X_train, y_train, X_val, y_val)

    test_pred = pipe.predict(X_test)
    test_f1 = f1_score(y_test, test_pred, average="macro")
    log.info("[%s] FINAL test macro-F1 = %.4f", scope_label, test_f1)
    log.info("\n%s", classification_report(y_test, test_pred, target_names=["human_written", "ai_generated"]))

    out_path = MODELS_DIR / f"baseline_{scope_label}.joblib"
    joblib.dump({"model_name": model_name, "pipeline": pipe, "feature_cols": feature_cols}, out_path)
    log.info("Saved model: %s", out_path)

    if not skip_shap:
        run_shap(model_name, pipe, X_train, X_test, scope_label)


def main():
    parser = argparse.ArgumentParser(description="Train the CodeTrust baseline model.")
    parser.add_argument("--per-language", action="store_true",
                         help="Train one model per language instead of one combined model.")
    parser.add_argument("--language", choices=config.LANGUAGES, default=None,
                         help="Train (only) this language. Implies a single-language model.")
    parser.add_argument("--skip-shap", action="store_true")
    args = parser.parse_args()

    train, val, test = load_split("train"), load_split("val"), load_split("test")
    log.info("Loaded splits: train=%d val=%d test=%d", len(train), len(val), len(test))
    check_problem_id_leakage(train, test)

    if args.language:
        run_scope(args.language, train, val, test, args.skip_shap)
    elif args.per_language:
        for lang in config.LANGUAGES:
            run_scope(lang, train, val, test, args.skip_shap)
    else:
        run_scope(None, train, val, test, args.skip_shap)


if __name__ == "__main__":
    main()
